# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ── Portal base URL — the SINGLE switch for all environments ──────────────────
# Every portal URL in the suite is derived from this one value (see config.py):
#   MPPA_BASE_URL          -> agency auth area   (.../module/agency/auth)
#   AGENCY_BASE / FORMS_*  -> agency + forms areas
#   ADMIN_BASE             -> admin area         (.../module/admin)
#   NOTICES_URL            -> agency notice board (.../module/notices.php)
# To point the whole suite at dev vs prod, change ONLY this line.
# Dev:  https://devmppa.sppuef.in/module/agency/auth/
# Prod: https://mppa.sppuef.in/module/agency/auth/
# A trailing slash is tolerated (config.py strips it).
MPPA_BASE_URL=https://mppa.sppuef.in/module/agency/auth/

# ── Portal credentials ────────────────────────────────────────────────────────
MPPA_USERNAME=test_user
MPPA_PASSWORD=

# Rejected user
REJECTED_AGENCY_USERNAME=
REJECTED_AGENCY_PASSWORD=

# Locked user
LOCKED_AGENCY_USERNAME=

# Form-submitted user
SUBMITTED_FORM_USERNAME=
SUBMITTED_FORM_PASSWORD=

# Super admin
ADMIN_SUPER_USERNAME=
ADMIN_SUPER_PASSWORD=

# ── Email OTP (testmail.app) ──────────────────────────────────────────────────
TESTMAIL_API_KEY=
TESTMAIL_NAMESPACE=

# ── Test mode ─────────────────────────────────────────────────────────────────
HEADLESS=false
SLOW_MO=100

# ── AIO Tests for Jira — REST upload of pytest results ────────────────────────
AIO_BASE_URL=https://tcms.aiojiraapps.com/aio-tcms/api/v1
AIO_API_TOKEN=
AIO_PROJECT_KEY=KAN
AIO_CYCLE_KEY=KAN-CY-Adhoc

# ── Notion — API integration (scripts/sync_allure_to_notion.py) ───────────────
NOTION_API_TOKEN=
